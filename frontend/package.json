  "optionalDependencies": {
    "@rolldown/binding-win32-x64-msvc": "^1.0.2"
  },
  "overrides": {
    "esbuild": "^0.28.1"
  },
  "engines": {
    "node": "^20.19.0 || ^22.12.0"
  }
