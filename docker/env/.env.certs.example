# ============================================================================
# Delivera Certificates Configuration
# ============================================================================
#
# This file contains the certificate-related variables that must remain
# consistent across Docker, Spring Boot configuration and certificate
# generation scripts.
#
# Additional certificate settings such as:
#   - CA_NAME
#   - CA_VALIDITY_DAYS
#   - CERT_VALIDITY_DAYS
#   - KEY_SIZE
#   - SAN configuration
#
# are maintained directly in the certificate generation scripts.
#
# If you need to modify the PKI generation process, please refer to:
#   docker/generate-certs.sh
#
# ============================================================================

CA_NAME="MyInternalCA"
CA_VALIDITY_DAYS="3650"
CERT_VALIDITY_DAYS="365"

AUTH_PASSWORD=delivera_auth_password

DATA_PASSWORD=delivera_data_password

DELIVERA_PASSWORD=delivera_password

NGINX_PASSWORD=delivera_nginx_password


# ============================================================================
# Certificates
# ============================================================================
#
# In the current project version the keystore and truststore use
# the same password. Both variables must contain the same value.
#
# ============================================================================


# AUTH SERVICE 
AUTH_KEY_STORE=file:/app/certs/auth-service-keystore.p12
AUTH_TRUST_STORE=file:/app/certs/auth-service-truststore.p12
AUTH_KEYSTORE_PASSWORD=delivera_auth_password
AUTH_TRUSTSTORE_PASSWORD=delivera_auth_password
AUTH_KEY_STORE_TYPE=PKCS12
AUTH_TRUST_STORE_TYPE=PKCS12

# DATA SERVICE 
DATA_KEY_STORE=file:/app/certs/data-service-keystore.p12
DATA_TRUST_STORE=file:/app/certs/data-service-truststore.p12
DATA_KEYSTORE_PASSWORD=delivera_data_password
DATA_TRUSTSTORE_PASSWORD=delivera_data_password
DATA_KEY_STORE_TYPE=PKCS12
DATA_TRUST_STORE_TYPE=PKCS12

# DELIVERA SERVICE 
DELIVERA_KEY_STORE=file:/app/certs/delivera-service-keystore.p12
DELIVERA_TRUST_STORE=file:/app/certs/delivera-service-truststore.p12
DELIVERA_KEYSTORE_PASSWORD=delivera_password
DELIVERA_TRUSTSTORE_PASSWORD=delivera_password
DELIVERA_KEY_STORE_TYPE=PKCS12
DELIVERA_TRUST_STORE_TYPE=PKCS12














