# ============================================================================
# Authentication Database Configuration
# ============================================================================
#
# Loaded before env.mode files.
# Any variable defined in env.dev, env.prod or env.local
# will override the values declared here.
#
# IMPORTANT:
# Keep the same naming convention for all services:
#
# DATABASE_<SERVICE>_URL
# DATABASE_<SERVICE>_NAME
# DATABASE_<SERVICE>_USER
# DATABASE_<SERVICE>_PASSWORD
#
# Environment-specific files may override these values to connect
# to different databases for development, testing, staging or
# production deployments.
#
# ============================================================================

DATABASE_AUTH_URL=jdbc:postgresql://auth-postgres:5432/delivera_auth_dev
DATABASE_AUTH_NAME=delivera_auth_dev
DATABASE_AUTH_USER=delivera_auth_user
DATABASE_AUTH_PASSWORD=delivera_auth_pass
